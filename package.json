  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit:rules": "node scripts/audit-rules.mjs",
    "verify": "pnpm check && pnpm typecheck && pnpm audit:rules && pnpm test && pnpm build",
    "xmpp:up": "docker compose -f dev/xmpp/compose.yml up -d",
    "xmpp:down": "docker compose -f dev/xmpp/compose.yml down",
    "test:integration": "XMPP_INTEGRATION=1 vitest run src/lib/xmpp/client.integration.test.ts src/lib/xmpp/omemo-pep.integration.test.ts src/lib/xmpp/omemo-message.integration.test.ts",
    "react:doctor": "pnpm dlx react-doctor@latest ."
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
