    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "events": "^3.3.0",
    "frimousse": "^0.4.0",
    "input-otp": "^1.5.0",
    "libomemo.js": "3.0.0",
    "nitro": "3.0.260610-beta",
    "react": "^19.2.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.2.0",
    "react-hot-toast": "^2.6.1",
    "react-resizable-panels": "^4.15.0",
    "recharts": "3.8.0",
